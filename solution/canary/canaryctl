#!/usr/bin/env python3
"""canaryctl up | start [--dwell S] | status | reset

Run as root from the default network namespace (the node agent's view). Every long-running process
it starts (nginx and the engine) enters the canary netns while still privileged, then drops to
canary with no groups and no capabilities; nginx daemonises itself, the engine gets `setsid -f`."""
import argparse, json, os, pwd, signal, subprocess, sys, time, uuid
HERE = os.path.dirname(os.path.realpath(__file__)); sys.path.insert(0, HERE)
from common import (RUN, LOGDIR, LIB, STATUS, EVENTS, ACCESS_LOG, ERROR_LOG, ENGINE_PID, IDLE, load_state,
                    save_state, desired_weights, write_conf, nginx_pid, kill_stray_nginx, start_nginx, apply,
                    read_pid, alive, write_status, status_from_state, event, reconcile_events)

U = pwd.getpwnam("canary"); NETNS = "/run/netns/canary"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": U.pw_dir, "USER": "canary", "LANG": "C.UTF-8"}

def drop():
    """Prefix that enters the netns as root, then becomes canary with nothing left over."""
    if os.getuid() == 0:
        return ["nsenter", f"--net={NETNS}", "--", "setpriv", f"--reuid={U.pw_uid}", f"--regid={U.pw_gid}",
                "--clear-groups", "--inh-caps=-all", "--bounding-set=-all", "--no-new-privs", "--"]
    if os.getuid() == U.pw_uid and os.stat("/proc/self/ns/net").st_ino == os.stat(NETNS).st_ino: return []
    sys.exit("canaryctl: run as root, or as canary inside the canary network namespace")

def own(path):
    if os.getuid() == 0: os.chown(path, U.pw_uid, U.pw_gid)

def prepare():
    """Directories and files the canary-owned processes write, created as canary's (a reboot wipes /run)."""
    for d in (RUN, LOGDIR, LIB, f"{LIB}/nginx"): os.makedirs(d, exist_ok=True); own(d)
    for d in ("client_body", "proxy", "fastcgi", "uwsgi", "scgi"): os.makedirs(f"{LIB}/nginx/{d}", exist_ok=True); own(f"{LIB}/nginx/{d}")
    for f in (EVENTS, ACCESS_LOG, ERROR_LOG):
        with open(f, "a"): pass
        own(f)

def engine_pid():
    pid = read_pid(ENGINE_PID)
    try:
        with open(f"/proc/{pid}/cmdline") as f: ok = "engine.py" in f.read()
        return pid if ok and alive(pid, "python3") else None
    except (OSError, TypeError): return None

def ensure_nginx(st):
    """nginx serving the split the durable state calls for. Left alone while an engine owns it."""
    if nginx_pid() and engine_pid(): return          # a running engine owns nginx's config
    b, g = desired_weights(st)
    changed = write_conf(b, g); own(f"{LIB}/nginx.conf")
    if not nginx_pid():
        kill_stray_nginx(U.pw_uid)
        if not start_nginx(drop()): sys.exit(f"canaryctl: nginx did not start (see {ERROR_LOG})")
    elif changed:
        apply(st)

def launch_engine(resume):
    args = ["python3", "-I", f"{HERE}/engine.py"] + (["--resume"] if resume else [])
    with open(f"{LOGDIR}/engine.out", "ab") as lf:
        own(f"{LOGDIR}/engine.out")
        subprocess.run(drop() + ["setsid", "-f"] + args, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf,
                       env=ENV, check=True, cwd="/")
    for _ in range(50):
        pid = engine_pid()
        if pid and read_status().get("pid") == pid: return pid
        time.sleep(0.1)
    sys.exit("canaryctl: engine did not report within 5 s")

def stop_engine():
    pid = engine_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not alive(pid, "python3"): break
            time.sleep(0.1)

def read_status():
    try:
        with open(STATUS) as f: return json.load(f)
    except (OSError, ValueError): return {}

def up():
    prepare(); st = load_state()
    ensure_nginx(st)
    if st["state"] == "shifting":
        if not engine_pid(): launch_engine(resume=True)
    else:
        reconcile_events(st)                       # a decision the crash cut off still gets logged once
        if read_status().get("rollout_id") != st["rollout_id"] or not os.path.exists(STATUS):
            write_status(status_from_state(st, pid=None)); own(STATUS)

def new_state(**kw): return {**IDLE, **kw}

ap = argparse.ArgumentParser(prog="canaryctl"); sub = ap.add_subparsers(dest="cmd", required=True)
sub.add_parser("up"); sub.add_parser("status"); sub.add_parser("reset")
s = sub.add_parser("start"); s.add_argument("--dwell", type=float, default=30)
a = ap.parse_args()

if a.cmd == "up":
    up()
elif a.cmd == "status":
    pass
elif a.cmd == "reset":
    prepare(); stop_engine(); st = new_state(); save_state(st); own(f"{LIB}/state.json")
    ensure_nginx(st); write_status(status_from_state(st)); own(STATUS); event({"type": "reset"})
elif a.cmd == "start":
    if a.dwell < 10: sys.exit("canaryctl: --dwell must be >= 10 seconds (one full evaluation window)")
    prepare(); stop_engine()
    st = new_state(rollout_id=uuid.uuid4().hex[:12], state="shifting", stage=1, dwell=a.dwell, stage_entered_at=time.time())
    save_state(st); own(f"{LIB}/state.json")      # the engine logs the stage 1 event (or recovery does)
    ensure_nginx(st); launch_engine(resume=False)
print(json.dumps(read_status() or status_from_state(load_state())))
