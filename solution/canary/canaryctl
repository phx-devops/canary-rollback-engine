#!/usr/bin/env python3
"""canaryctl up | start [--dwell S] | status | reset

Run as root from the default network namespace (or as canary inside the canary netns). Every
long-running process it starts (the proxy and the engine) enters the netns while still privileged,
then drops to canary with no groups and no capabilities, then detaches into its own session."""
import argparse, json, os, pwd, signal, subprocess, sys, time, uuid
HERE = os.path.dirname(os.path.realpath(__file__)); sys.path.insert(0, HERE)
from common import RUN, LOGDIR, PROXY_SOCK, STATUS, EVENTS, proxy_argv, proxy_pid, set_weights, write_status, event

U = pwd.getpwnam("canary"); NETNS = "/run/netns/canary"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "HOME": U.pw_dir, "USER": "canary", "LANG": "C.UTF-8"}

def in_target():
    return os.getuid() == U.pw_uid and os.stat("/proc/self/ns/net").st_ino == os.stat(NETNS).st_ino

def launch(argv, log):
    if os.getuid() == 0:
        pre = ["nsenter", f"--net={NETNS}", "--", "setpriv", f"--reuid={U.pw_uid}", f"--regid={U.pw_gid}", "--clear-groups",
               "--inh-caps=-all", "--bounding-set=-all", "--no-new-privs", "--", "setsid", "-f"]
    elif in_target(): pre = ["setsid", "-f"]
    else: sys.exit("canaryctl: run as root, or as canary inside the canary network namespace")
    with open(log, "ab") as lf:
        if os.getuid() == 0: os.fchown(lf.fileno(), U.pw_uid, U.pw_gid)   # the canary-owned processes reopen it
        subprocess.run(pre + argv, stdin=subprocess.DEVNULL, stdout=lf, stderr=lf, env=ENV, check=True, cwd="/")

def engine_pid():
    try:
        pid = int(open(f"{RUN}/engine.pid").read())
        with open(f"/proc/{pid}/cmdline") as f: return pid if "engine.py" in f.read() else None
    except (OSError, ValueError): return None

def mkdirs():
    for d in (RUN, LOGDIR):
        os.makedirs(d, exist_ok=True)
        if os.getuid() == 0: os.chown(d, U.pw_uid, U.pw_gid)
    # Create the event log as canary's before anyone appends to it: if root's `reset` created it first,
    # the engine (running as canary) could not write to it.
    with open(EVENTS, "a"): pass
    if os.getuid() == 0: os.chown(EVENTS, U.pw_uid, U.pw_gid)

def idle():
    write_status({"rollout_id": None, "state": "idle", "stage": None, "weights": {"app-blue": 100, "app-green": 0},
                  "pid": None, "window": None, "abort_reason": None})
    if os.getuid() == 0: os.chown(STATUS, U.pw_uid, U.pw_gid)

def up():
    mkdirs()
    if not proxy_pid():
        launch(proxy_argv(), f"{LOGDIR}/proxy.out")
        for _ in range(50):
            if proxy_pid() and os.path.exists(PROXY_SOCK): break
            time.sleep(0.1)
        else: sys.exit("canaryctl: proxy did not come up (see /var/log/canary/proxy.out)")
    if not engine_pid():
        set_weights(100, 0)
        if not os.path.exists(STATUS): idle()

def stop_engine():
    pid = engine_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(50):
            if not os.path.exists(f"/proc/{pid}"): break
            time.sleep(0.1)

def status():
    try:
        with open(STATUS) as f: return json.load(f)
    except OSError: return {"state": "idle"}

ap = argparse.ArgumentParser(prog="canaryctl"); sub = ap.add_subparsers(dest="cmd", required=True)
sub.add_parser("up"); sub.add_parser("status"); sub.add_parser("reset")
s = sub.add_parser("start"); s.add_argument("--dwell", type=float, default=30)
a = ap.parse_args()

if a.cmd == "up": up(); print(json.dumps(status()))
elif a.cmd == "status": print(json.dumps(status()))
elif a.cmd == "reset":
    up(); stop_engine(); set_weights(100, 0); idle(); event({"type": "reset"}); print(json.dumps(status()))
elif a.cmd == "start":
    if a.dwell < 10: sys.exit("canaryctl: --dwell must be >= 10 seconds (one full evaluation window)")
    up(); stop_engine(); set_weights(100, 0)
    rid = uuid.uuid4().hex[:12]
    launch(["python3", "-I", f"{HERE}/engine.py", "--dwell", str(a.dwell), "--id", rid], f"{LOGDIR}/engine.out")
    for _ in range(50):
        st = status()
        if st.get("rollout_id") == rid: print(json.dumps(st)); sys.exit(0)
        time.sleep(0.1)
    sys.exit("canaryctl: engine did not report within 5 s")
